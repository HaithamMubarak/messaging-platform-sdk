# ========================================
# SDK Local Service Configuration
# ========================================
# Copy this file to 'application.properties' in the same directory as the JAR file
# to customize settings without rebuilding

# ========================================
# Server Configuration
# ========================================
server.port=8088

# ========================================
# Database Configuration
# ========================================
# Database file location (relative to JAR directory)
spring.datasource.url=jdbc:h2:file:./sls-data

# ========================================
# H2 Console (Database Viewer)
# ========================================
# Access at: http://localhost:8088/h2-console
# JDBC URL: jdbc:h2:file:./sls-data
# Username: sa
# Password: (leave empty)
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# ========================================
# CORS Configuration
# ========================================
# Add your web UI domains here
spring.web.cors.allowed-origins=https://hmdevonline.com,http://localhost:8090,http://localhost:3000

# ========================================
# Performance & Limits
# ========================================
# Command timeout (milliseconds)
mls.command.timeout=30000

# Maximum concurrent commands
mls.command.maxConcurrent=10

# Maximum active sessions
mls.session.maxActive=50

# Session timeout (milliseconds) - 1 hour
mls.session.timeout=3600000

# ========================================
# Logging
# ========================================
# Log level: TRACE, DEBUG, INFO, WARN, ERROR
logging.level.com.hmdev.sdk.local=INFO

# Log file location
logging.file.name=./logs/sls.log

# ========================================
# Advanced Settings
# ========================================
# Default shell (bash, cmd, powershell)
mls.command.shell=bash

# TCP forwarding limits
mls.tcp.maxForwardingRules=20
mls.tcp.bufferSize=8192

# Data directory
mls.data.directory=./sls-data

# ========================================
# DO NOT MODIFY BELOW (Internal Settings)
# ========================================
spring.application.name=messaging-local-service
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.h2.console.settings.web-allow-others=false
spring.web.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.web.cors.allowed-headers=*
spring.web.cors.allow-credentials=true
logging.pattern.console=%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
mls.version=1.0.0

