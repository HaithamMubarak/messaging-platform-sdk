# CMake package for the C++ messaging agent.
#
#   find_package(messaging-cpp-agent CONFIG REQUIRED)
#   target_link_libraries(my_game PRIVATE hmdev::messaging-cpp-agent)
#
# The library's public headers use nlohmann/json and its binary links libcurl
# and OpenSSL, so a consumer needs those found too; find_dependency does it
# with the consumer's own CMAKE_PREFIX_PATH / toolchain (vcpkg included).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CURL)
find_dependency(OpenSSL)
find_dependency(nlohmann_json 3.10)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/messaging-cpp-agentTargets.cmake")

check_required_components(messaging-cpp-agent)
