# SDK .gitignore 
 
# Gradle 
.gradle/ 
*.gradle.kts.compiled 
gradle-app.setting 
!gradle-wrapper.jar 
!gradle-wrapper.properties 
 
# IDE 
.idea/ 
.vscode/ 
*.iml 
*.iws 
*.ipr 
out/ 
 
# Build output
/build/
build/classes/
/build/classes/ 

# Agents build outputs - but allow sdk-local-service JAR
agents/build/
agents/*/build/
agents/*/*/build/
# Exception: sdk-local-service JAR is tracked
!agents/examples/sdk-local-service/build/
!agents/examples/sdk-local-service/build/libs/
!agents/examples/sdk-local-service/build/libs/sdk-local-service.jar


# Ensure sdk/libs is not ignored 
!/libs/ 
!/libs/** 
 
# Python 
**/__pycache__/ 
*.py[cod] 
*$py.class 
*.so 
.Python 
env/ 
venv/ 
*.egg-info/ 
dist/ 
 
# Node.js 
node_modules/ 
# Gradle
.gradle/
build/
out/
**/build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
bin/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node (for web-agent)
node_modules/
dist/
.cache/

# Python (for python-agent)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Java
*.class
*.jar
!gradle/wrapper/*.jar
target/

# Test
.pytest_cache/
coverage/
*.coverage

# Environment files (sensitive - NEVER commit)
.env
.env.local
.env.*.local
*.env

# Database files (local data - NEVER commit)
*.mv.db
*.trace.db
mls-data*
sls-data*
**/mls-data*
**/sls-data*

# JAR files (except gradle wrapper and sdk-local-service build output)
*.jar
!gradle/wrapper/*.jar
!gradle-wrapper.jar
!agents/examples/sdk-local-service/build/libs/sdk-local-service.jar

